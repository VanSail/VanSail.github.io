{
  "name": "van-sail-github-io",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "node scripts/start-i18n.mjs",
    "start:i18n": "node scripts/start-i18n.mjs",
    "start:dev": "docusaurus start",
    "start:zh": "docusaurus start",
    "start:en": "docusaurus start --locale en --port 3001",
    "build": "docusaurus build",
    "serve": "docusaurus serve",
    "clear": "docusaurus clear",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "typecheck": "tsc",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,css,json}\" --ignore-path .gitignore --ignore-path .prettierignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,css,json}\" --ignore-path .gitignore --ignore-path .prettierignore",
    "prepare": "husky"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.1",
    "@docusaurus/faster": "3.10.1",
    "@docusaurus/preset-classic": "3.10.1",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "dxf-viewer": "1.0.51",
    "esbuild": "0.28.2",
    "occt-import-js": "0.0.23",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@docusaurus/module-type-aliases": "3.10.1",
    "@docusaurus/tsconfig": "3.10.1",
    "@docusaurus/types": "3.10.1",
    "@types/react": "^19.0.0",
    "chokidar": "^3.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.4",
    "prettier": "^3.9.5",
    "typescript": "~6.0.2"
  },
  "packageManager": "yarn@1.22.22",
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20 <25"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,css,json}": "prettier --write"
  },
  "resolutions": {
    "dxf-viewer/opentype.js": "1.3.4"
  }
}
